ENVIRONMENT=development

MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=terdin_date
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-32-or-more-characters-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# The product name in SMS, push and the API docs.
APP_NAME=Terdin

SMS_PROVIDER=console
OTP_TTL=300
OTP_MAX_ATTEMPTS=5

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=terdin-media
S3_ACCESS_KEY=terdin-local
S3_SECRET_KEY=terdin-local-secret
S3_PUBLIC_BASE_URL=http://localhost:8333/terdin-media

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_JSON=false


# Off until the worker runs: uv run --extra face python -m app.cli verification-worker
VERIFICATION_ENABLED=false
VERIFICATION_MAX_ATTEMPTS_PER_DAY=3
VERIFICATION_CHALLENGE_TTL=120
VERIFICATION_PENDING_TIMEOUT=600
VERIFICATION_AUTO_RATIO=0.8
VERIFICATION_YAW_STRAIGHT_MAX=0.12
VERIFICATION_YAW_TURN_MIN=0.25

# Needs the worker: `pnpm services:up` starts it in Docker, or
# uv run --extra vision python -m app.cli face-check-worker
FACE_CHECK_ENABLED=true
FACE_CHECK_WAIT_SECONDS=3.0
FACE_CHECK_MIN_SCORE=0.8
FACE_CHECK_MIN_AREA=0.01
FACE_CHECK_SECOND_FACE_RATIO=0.5

# Push worker: uv run python -m app.cli push-worker
EXPO_ACCESS_TOKEN=
