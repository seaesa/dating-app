ENVIRONMENT=development

MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=terdin_date
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-32-or-more-characters-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

SMS_PROVIDER=console
OTP_TTL=300
OTP_MAX_ATTEMPTS=5

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=terdin-media
S3_ACCESS_KEY=terdin-local
S3_SECRET_KEY=terdin-local-secret
S3_PUBLIC_BASE_URL=http://localhost:8333/terdin-media

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_JSON=false

