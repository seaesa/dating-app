# The product name: app name, permission prompts and in-app copy.
EXPO_PUBLIC_APP_NAME=Terdin

# On a physical device this must be the host machine's LAN address, not
# localhost — localhost on a device is the device itself.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Public legal pages linked from sign-up. Required before a store release.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Android push (FCM): google-services.json from the Firebase console. Locally a
# path such as ./google-services.json; on EAS a file environment variable.
GOOGLE_SERVICES_JSON=
