  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "~19.2.10",
    "eas-cli": "^24.8.0",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
