{$DOMAIN} {
	encode zstd gzip

	# The API is served under /api so the browser and the app share one origin,
	# which keeps CORS out of production entirely.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Content-Security-Policy is set by apps/web/proxy.ts: it needs a
		# per-request nonce, which only the app can generate.
	}
}
