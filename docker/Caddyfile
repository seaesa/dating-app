{$DOMAIN} {
	encode zstd gzip

	# The API is served under /api so the browser and the app share one origin,
	# which keeps CORS out of production entirely.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The refresh token lives in localStorage (spec §10), so a strict CSP is
		# what keeps an injected script from reading it. Loosening this weakens
		# the mitigation that decision depends on.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
	}
}
