# The product name in SMS, push and the admin. The web image and the mobile
# builds read it at build time: set the repository variable APP_NAME and
# EXPO_PUBLIC_APP_NAME in the EAS environment to the same value.
APP_NAME=
# Caddy's site address. A domain gets automatic HTTPS; `:80` serves plain HTTP
# on the IP, for a host with no domain yet.
DOMAIN=terdin.example.com
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest

# Host ports Caddy publishes. Change them when another stack on this host
# already holds 80/443 (HTTPS needs a domain and the real 443 anyway).
# HTTP_PORT=80
# HTTPS_PORT=443

# Starts the self-hosted mongo, redis and s3 services of docker-compose.prod.yml.
# Leave unset when MONGODB_URL, REDIS_URL and S3_* point at managed services.
# COMPOSE_PROFILES=selfhosted

# `production` unless this is a demo with no Twilio account: `development`
# allows SMS_PROVIDER=console, which RETURNS THE OTP CODE TO THE CLIENT, so
# anyone can sign in as any phone number. Never with real users.
# ENVIRONMENT=production

MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
# Self-hosted (COMPOSE_PROFILES=selfhosted):
# MONGODB_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DB=terdin_date
REDIS_URL=redis://:password@redis-host:6379/0
# Self-hosted: REDIS_URL=redis://redis:6379/0

# openssl rand -hex 32
JWT_SECRET=

# The API refuses to boot in production on SMS_PROVIDER=console, which would
# send nothing and log live OTP codes.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The API also refuses to boot if these still hold the local defaults.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=terdin-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://media.terdin.example.com
# Self-hosted: the s3 service takes its keys from S3_ACCESS_KEY/S3_SECRET_KEY
# (openssl rand -hex 24), and S3_ENDPOINT must be the address phones reach,
# because presigned URLs carry it:
# S3_ENDPOINT=http://<public ip>:8333
# S3_PUBLIC_BASE_URL=http://<public ip>:8333/terdin-media
# S3_PORT=8333

# Where the browser reaches the API.
#
# Optional. It is inlined into client JavaScript when the web image is built:
# it takes effect on `docker compose up -d --build`, not on a pulled image.
# The default is /api, which is where docker/Caddyfile serves the API on the same
# origin as the web app, so the documented deploy needs no override.
#
# Override it only when the API lives on another origin, and then also set it as
# the repository variable NEXT_PUBLIC_API_URL so published images are built with it.
# NEXT_PUBLIC_API_URL=https://api.example.com

# VietQR image style. Bank name, number and token are set in the admin web.
WEB2M_IS_MASK=true
WEB2M_BANK_BACKGROUND=13
