# The product name in SMS, push and the admin. The web image and the mobile
# builds read it at build time: set the repository variable APP_NAME and
# EXPO_PUBLIC_APP_NAME in the EAS environment to the same value.
APP_NAME=
DOMAIN=terdin.example.com
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest

MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
MONGODB_DB=terdin_date
REDIS_URL=redis://:password@redis-host:6379/0

# openssl rand -hex 32
JWT_SECRET=

# The API refuses to boot in production on SMS_PROVIDER=console, which would
# send nothing and log live OTP codes.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The API also refuses to boot if these still hold the local defaults.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=terdin-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://media.terdin.example.com

# Where the browser reaches the API.
#
# Optional. It is inlined into client JavaScript when the web IMAGE is built, so
# setting it here changes nothing — it is a build argument, not a runtime one.
# The default is /api, which is where docker/Caddyfile serves the API on the same
# origin as the web app, so the documented deploy needs no override.
#
# Override it only when the API lives on another origin, and then set it as the
# repository variable NEXT_PUBLIC_API_URL so published images are built with it.
# NEXT_PUBLIC_API_URL=https://api.example.com
