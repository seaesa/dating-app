{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format:check": {},
    "clean": {
      "cache": false
    },
    "generate": {
      "inputs": ["openapi.json", "openapi-ts.config.ts"],
      "outputs": ["src/generated/**"],
      "cache": false
    }
  }
}
