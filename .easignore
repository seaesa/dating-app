# What NOT to upload to an EAS build.
#
# At the repository root, not in apps/mobile: in a pnpm workspace EAS archives
# the whole workspace so the shared packages resolve, and an ignore file inside
# apps/mobile cannot exclude a sibling app.
node_modules
.turbo
.expo
.next
dist
build
coverage

# Continuous Native Generation regenerates these during the build. Anchored:
# a bare "android" would also drop the local modules' native code.
/apps/mobile/ios
/apps/mobile/android

# A developer's .env (LAN API URL, local file paths) must not reach a cloud
# build: there, eas.json and EAS environment variables are the source. This file
# replaces .gitignore for EAS, so its .env rules do not apply here.
**/.env
**/.env.*
!**/.env.example

# Nothing the bundler reads.
apps/api
docs
.superpowers
.github
docker
*.log
