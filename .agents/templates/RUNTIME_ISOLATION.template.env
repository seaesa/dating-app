# ===================================================================
# RUNTIME ISOLATION ENVIRONMENT CONFIGURATION (.env.local)
# Project: Harness Engineering — Worktree Runtime Isolation
# ===================================================================

# Identifiers
TASK_ID=<TASK-ID>
RUNTIME_NAMESPACE=worktree_<TASK-ID_SLUG>

# Network Isolation (Port Offset per Worktree)
# Base Port: 3000 -> Worktree Port: 43<PORT_OFFSET>
HTTP_PORT=43<PORT_OFFSET>
METRICS_PORT=49<PORT_OFFSET>

# Database Namespace (Schema Isolation)
# Prevents cross-worktree DB migration contamination
DATABASE_URL=postgresql://user:password@localhost:5432/main_db?schema=schema_worktree_<TASK-ID_SLUG>
DATABASE_SCHEMA=schema_worktree_<TASK-ID_SLUG>

# Cache & Storage Isolation
CACHE_PREFIX=worktree_<TASK-ID_SLUG>:
TEMP_DIRECTORY=.tmp/worktree_<TASK-ID_SLUG>
LOG_FILE=.tmp/worktree_<TASK-ID_SLUG>/runtime.log
