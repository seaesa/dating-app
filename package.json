{
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "services:up": "docker compose up -d --wait mongo redis s3",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && pnpm services:up",
    "services:logs": "docker compose logs -f",
    "openapi": "pnpm --filter=api run openapi",
    "generate": "turbo run generate",
    "contract": "pnpm --filter=api run openapi && pnpm --filter=@repo/api-contract run generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "name": "terdin-date",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1"
    }
  }
}
