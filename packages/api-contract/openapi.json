{
  "components": {
    "schemas": {
      "GeoPoint": {
        "additionalProperties": false,
        "description": "GeoJSON point.\n\nLongitude first \u2014 MongoDB's 2dsphere index requires that order, and\nreversing it silently places everyone in the wrong hemisphere.",
        "properties": {
          "coordinates": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "GeoPoint",
        "type": "object"
      },
      "MediaKind": {
        "enum": [
          "public",
          "private"
        ],
        "title": "MediaKind",
        "type": "string"
      },
      "Message": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Message",
        "type": "object"
      },
      "OtpRequestBody": {
        "additionalProperties": false,
        "properties": {
          "phone": {
            "maxLength": 20,
            "minLength": 6,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "OtpRequestBody",
        "type": "object"
      },
      "OtpRequestResponse": {
        "additionalProperties": false,
        "properties": {
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          }
        },
        "required": [
          "expiresIn"
        ],
        "title": "OtpRequestResponse",
        "type": "object"
      },
      "OtpVerifyBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 8,
            "minLength": 4,
            "pattern": "^\\d+$",
            "title": "Code",
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 6,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone",
          "code"
        ],
        "title": "OtpVerifyBody",
        "type": "object"
      },
      "PrivateIdentityRead": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "photoUrls": {
            "items": {
              "type": "string"
            },
            "title": "Photourls",
            "type": "array"
          },
          "realName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realname"
          },
          "socials": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Socials",
            "type": "object"
          }
        },
        "required": [
          "realName",
          "photoUrls",
          "socials",
          "location"
        ],
        "title": "PrivateIdentityRead",
        "type": "object"
      },
      "PrivateIdentityUpdate": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "photoMediaIds": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PydanticObjectId"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photomediaids"
          },
          "realName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realname"
          },
          "socials": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Socials"
          }
        },
        "title": "PrivateIdentityUpdate",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "RFC 9457 problem document \u2014 the shape EVERY failure takes.\n\nDeclared as a schema so it reaches the OpenAPI document. Without it the\nonly documented error is FastAPI's default HTTPValidationError, and the\ngenerated TypeScript describes an error shape this API never returns.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "requestId"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PublicProfileRead": {
        "additionalProperties": false,
        "properties": {
          "age": {
            "title": "Age",
            "type": "integer"
          },
          "avatarUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatarurl"
          },
          "bio": {
            "title": "Bio",
            "type": "string"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "title": "Interests",
            "type": "array"
          },
          "nickname": {
            "title": "Nickname",
            "type": "string"
          }
        },
        "required": [
          "nickname",
          "age",
          "city",
          "bio",
          "interests"
        ],
        "title": "PublicProfileRead",
        "type": "object"
      },
      "PublicProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "avatarMediaId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PydanticObjectId"
              },
              {
                "type": "null"
              }
            ]
          },
          "bio": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "birthYear": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1900.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birthyear"
          },
          "city": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "interests": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interests"
          },
          "nickname": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          }
        },
        "title": "PublicProfileUpdate",
        "type": "object"
      },
      "PydanticObjectId": {
        "example": "5eb7cf5a86d9755df3a6c593",
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
      },
      "RefreshBody": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "title": "RefreshBody",
        "type": "object"
      },
      "TokenPair": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "isNewUser": {
            "default": false,
            "title": "Isnewuser",
            "type": "boolean"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          },
          "tokenType": {
            "default": "bearer",
            "title": "Tokentype",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ],
        "title": "TokenPair",
        "type": "object"
      },
      "UploadUrlBody": {
        "additionalProperties": false,
        "properties": {
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/MediaKind"
          },
          "size": {
            "exclusiveMinimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "contentType",
          "size"
        ],
        "title": "UploadUrlBody",
        "type": "object"
      },
      "UploadUrlResponse": {
        "additionalProperties": false,
        "properties": {
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "mediaId": {
            "$ref": "#/components/schemas/PydanticObjectId"
          },
          "uploadUrl": {
            "title": "Uploadurl",
            "type": "string"
          }
        },
        "required": [
          "mediaId",
          "uploadUrl",
          "expiresIn"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "UserRead": {
        "additionalProperties": false,
        "description": "The only user-shaped response the API emits.\n\n`identity` and `phone` are None for a public viewer. They are optional\nrather than absent so the generated TypeScript has one type for a user and\nthe client branches on null instead of on two different shapes.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/PydanticObjectId"
          },
          "identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrivateIdentityRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "profile": {
            "$ref": "#/components/schemas/PublicProfileRead"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        },
        "required": [
          "id",
          "status",
          "profile",
          "createdAt"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "UserStatus": {
        "enum": [
          "pending_onboarding",
          "active",
          "suspended"
        ],
        "title": "UserStatus",
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Terdin Date API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
